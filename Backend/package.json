    "mammoth": "^1.13.0",
    "mongoose": "^8.10.1",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.20.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
